# Copy to .env at the repo root. The worker, migrations and `pnpm dev` all read it.
# Never commit .env. On Vercel, set the "web" variables in the project settings instead.

# ---------------------------------------------------------------------------
# Database (Supabase > Project Settings > Database > Connection string)
# ---------------------------------------------------------------------------
# Session pooler (port 5432). Used by the worker, migrations and seed.
# Works over IPv4, unlike the direct connection.
DATABASE_URL_SESSION=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Transaction pooler (port 6543). Used by the web app (prepared statements are disabled for it).
DATABASE_URL_TRANSACTION=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# Auth (web app only; Supabase > Project Settings > API)
# Read only on the server. Not exposed to the browser (no NEXT_PUBLIC_ prefix).
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>

# Who may sign in. Comma separated.
ALLOWED_EMAILS=you@example.com,partner@example.com

# Public URL of the web app, used in magic link redirects. Leave unset locally.
# APP_URL=https://jobs.example.com

# ---------------------------------------------------------------------------
# Scoring (worker only)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Upwork (worker only). Leave blank to use fixtures/upwork/*.json instead.
# See README > "Upwork API credentials".
# ---------------------------------------------------------------------------
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
# Must exactly match the callback URL registered on the API key.
UPWORK_REDIRECT_URI=
# Optional bootstrap refresh token. Normally `pnpm --filter @jf/worker upwork:auth`
# stores tokens in the database and the worker rotates them there.
UPWORK_REFRESH_TOKEN=
# authorization_code (default) or client_credentials, if your key supports it.
# UPWORK_GRANT_TYPE=authorization_code
# Optional X-Upwork-API-TenantId header, if you belong to several organizations.
# UPWORK_TENANT_ID=

# ---------------------------------------------------------------------------
# Worker tuning (optional)
# ---------------------------------------------------------------------------
# WORKER_TICK_SECONDS=15
# LOG_LEVEL=info
# LOG_PRETTY=1
# FIXTURES_DIR=/app/fixtures
